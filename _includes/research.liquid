<section class="sp-section sp-section-alt" id="research">
  <div class="container">
    <div class="sp-section-header">
      <h2>Explore Our Research</h2>
      <div class="sp-rule"></div>
      <p>{{ page.small_description }}</p>
    </div>

    <div class="sp-research-grid">
      {% for post in site.researchs %}
      {% assign more_url = post.learn_more | default: post.url %}
      <a href="{{ more_url | relative_url }}" class="sp-research-card"{% if post.learn_more %} target="_blank" rel="noopener"{% endif %}>
        <div class="sp-rc-title">{{ post.title }}</div>
        <div class="sp-rc-img" style="background-image: url('{{ post.image }}');"></div>
        <div class="sp-rc-body">
          <div class="sp-rc-desc">{% if post.teaser %}{{ post.teaser }}{% else %}{{ post.excerpt | strip_html | truncate: 160 }}{% endif %}</div>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
